# Chép thành .env (cùng thư mục) TRÊN VPS rồi điền. Không commit .env, không dán các giá trị này vào chat.
TELEGRAM_BOT_TOKEN=          # @BotFather → /newbot → Source-hub
TELEGRAM_OWNER_ID=           # ID số Telegram của bạn (nhắn @userinfobot để biết)
SUPABASE_URL=https://dcbpgobninomfnrpnkyc.supabase.co
SUPABASE_SECRET_KEY=         # Supabase → Project Settings → API Keys → Secret key (sb_secret_...). KHÔNG đưa lên website
ANTHROPIC_API_KEY=           # console.anthropic.com → API Keys (nên đặt hạn mức chi tiêu)
